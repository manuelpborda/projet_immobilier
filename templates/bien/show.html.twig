{% extends 'base.html.twig' %}

{% block title %}{{ bien.typeDeBien }} en {{ bien.tipoTransaccion }} en {{ bien.ville }} - CONSORIA{% endblock %}

{% block body %}
<style>
    /* === ADAPTACIÓN AUTOMÁTICA DE COLORES (CLARO / OSCURO) === */
    .luxe-card-dynamic { background: var(--luxe-card-bg, #1C1E22); border: 1px solid rgba(212, 175, 55, 0.2); }
    .text-dynamic { color: #E4E7EC; }
    .text-dynamic-muted { color: #A0A0A0; }
    .box-specs { background: var(--luxe-black, #111); border: 1px solid rgba(255,255,255,0.05); }
    
    /* Cuando la etiqueta <html> tiene la clase light-mode */
    html.light-mode .luxe-card-dynamic { background: #FFFFFF; border: 1px solid rgba(0, 0, 0, 0.08); box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
    html.light-mode .text-dynamic { color: #212529; }
    html.light-mode .text-dynamic-muted { color: #6C757D; }
    html.light-mode .box-specs { background: #F8F9FA; border: 1px solid rgba(0,0,0,0.05); box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
</style>

<div class="container my-5">
    {# Botón para regresar al portafolio #}
    <div class="mb-4">
        <a href="{{ path('home') }}" class="text-decoration-none fw-bold" style="color: var(--luxe-gold); transition: all 0.3s ease;">
            <i class="fas fa-arrow-left me-2"></i>Volver al portafolio de inmuebles
        </a>
    </div>

    <div class="row gx-lg-5">
        {# COLUMNA IZQUIERDA: Galería Multimedia Luxe + Video YouTube #}
        <div class="col-lg-7 mb-4">
            
            {% if bien.foto %}
                {% set archivosMedia = bien.foto|split(',') %}
                
                <div id="bienCarousel" class="carousel slide shadow-lg rounded-4 overflow-hidden mb-3" style="border: 1px solid rgba(212, 175, 55, 0.2);" data-bs-ride="false">
                    <div class="carousel-inner" style="min-height: 400px; max-height: 550px; background: var(--luxe-black, #111);">
                        {% for archivo in archivosMedia %}
                            {% set extension = archivo|split('.')|last|lower %}
                            <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                                {% if extension in ['mp4', 'webm', 'mov', 'avi'] %}
                                    <div class="ratio ratio-16x9 d-flex align-items-center justify-content-center" style="max-height: 550px; background: #000;">
                                        <video controls playsinline preload="metadata" class="w-100 h-100" style="object-fit: contain;">
                                            <source src="{{ asset('uploads/bienes/' ~ archivo) }}" type="video/{{ extension == 'mov' ? 'quicktime' : extension }}">
                                            Tu navegador no soporta video.
                                        </video>
                                    </div>
                                {% else %}
                                    <img src="{{ asset('uploads/bienes/' ~ archivo) }}" alt="Fotografía del inmueble" class="d-block w-100" style="height: 550px; object-fit: cover; cursor: zoom-in;" onclick="abrirVisorLuxe(this.src)" title="Clic para ampliar">
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                    
                    <button class="carousel-control-prev" type="button" data-bs-target="#bienCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon p-3 rounded-circle" style="background-color: rgba(28, 30, 34, 0.8); border: 1px solid var(--luxe-gold);" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#bienCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon p-3 rounded-circle" style="background-color: rgba(28, 30, 34, 0.8); border: 1px solid var(--luxe-gold);" aria-hidden="true"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                </div>

                {# Miniaturas estilo Premium #}
                <div class="d-flex gap-2 overflow-x-auto pb-2 custom-scrollbar" style="white-space: nowrap; scrollbar-width: thin; scrollbar-color: var(--luxe-gold) var(--luxe-card-bg);">
                    {% for archivo in archivosMedia %}
                        {% set extension = archivo|split('.')|last|lower %}
                        <button type="button" data-bs-target="#bienCarousel" data-bs-slide-to="{{ loop.index0 }}" class="btn p-0 rounded-3 overflow-hidden flex-shrink-0 thumbnail-btn" style="width: 90px; height: 65px; border: 2px solid transparent; transition: all 0.3s ease;">
                            {% if extension in ['mp4', 'webm', 'mov', 'avi'] %}
                                <div class="d-flex align-items-center justify-content-center w-100 h-100 position-relative luxe-card-dynamic">
                                    <i class="fas fa-play fs-5 text-warning"></i>
                                </div>
                            {% else %}
                                <img src="{{ asset('uploads/bienes/' ~ archivo) }}" class="w-100 h-100" style="object-fit: cover;" alt="Miniatura">
                            {% endif %}
                        </button>
                    {% endfor %}
                </div>
            {% else %}
                <div class="carte-bien text-center py-5 d-flex flex-column align-items-center justify-content-center luxe-card-dynamic" style="min-height: 400px; border-radius: 12px;">
                    <i class="far fa-images fa-4x mb-3" style="color: var(--luxe-gold); opacity: 0.5;"></i>
                    <p class="m-0 text-dynamic-muted">Inmueble en proceso de sesión fotográfica.</p>
                </div>
            {% endif %}

            {# === REPRODUCTOR DE YOUTUBE AUTOMÁTICO === #}
            {% if bien.urlVideo %}
                <div class="video-container mt-4 p-4 rounded-4 luxe-card-dynamic">
                    <h4 class="fw-bold mb-4" style="color: var(--luxe-gold);">
                        <i class="fab fa-youtube text-danger me-2"></i> Recorrido Virtual 360°
                    </h4>
                    
                    <div class="ratio ratio-16x9">
                        <iframe id="youtube-iframe-{{ bien.id }}" src="" title="Recorrido Inmueble" allowfullscreen style="border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);"></iframe>
                    </div>

                    <script>
                        document.addEventListener("DOMContentLoaded", function() {
                            let rawUrl = "{{ bien.urlVideo }}";
                            let videoId = "";
                            
                            if (rawUrl.includes("watch?v=")) {
                                videoId = rawUrl.split("watch?v=")[1].split("&")[0];
                            } else if (rawUrl.includes("youtu.be/")) {
                                videoId = rawUrl.split("youtu.be/")[1].split("?")[0];
                            }

                            if (videoId) {
                                document.getElementById("youtube-iframe-{{ bien.id }}").src = "https://www.youtube.com/embed/" + videoId;
                            }
                        });
                    </script>
                </div>
            {% endif %}
            {# ======================================== #}

        </div>

        {# COLUMNA DERECHA: Ficha Técnica Luxe #}
        <div class="col-lg-5">
            <div class="carte-bien position-sticky luxe-card-dynamic" style="top: 100px; padding: 30px; border-radius: 15px;">
                <span class="badge bg-primary px-3 py-2 mb-3 fw-bold text-uppercase rounded-pill shadow-sm">{{ bien.tipoTransaccion }}</span>
                <h1 class="h3 fw-bold mb-2 text-dynamic">{{ bien.titulo }}</h1>
                
                <p class="small text-dynamic-muted">
                    <i class="fas fa-map-marker-alt me-2" style="color: var(--luxe-gold);"></i>
                    {{ bien.barrio ? bien.barrio ~ ' - ' : '' }}{{ bien.adresse }}, {{ bien.ville }}
                </p>
                
                <h2 class="display-6 fw-bold my-4" style="color: var(--luxe-gold); letter-spacing: -1px;">
                    $ {{ bien.prix|number_format(0, ',', '.') }} <span class="fs-5 text-dynamic-muted">COP</span>
                </h2>

                <hr style="border-color: rgba(212, 175, 55, 0.2); margin: 25px 0;">

                <h4 class="h6 fw-bold mb-3 text-uppercase" style="color: var(--luxe-gold); letter-spacing: 1px;">Especificaciones</h4>
                
                <div class="row text-center mb-4 g-2">
                    <div class="col-4">
                        <div class="p-3 rounded-3 box-specs">
                            <i class="fas fa-bed mb-2 d-block fs-5" style="color: var(--luxe-gold);"></i>
                            <span class="d-block small text-dynamic-muted">Habitaciones</span>
                            <strong class="text-dynamic fs-5">{{ bien.habitaciones }}</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3 box-specs">
                            <i class="fas fa-bath mb-2 d-block fs-5" style="color: var(--luxe-gold);"></i>
                            <span class="d-block small text-dynamic-muted">Baños</span>
                            <strong class="text-dynamic fs-5">{{ bien.banos }}</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3 box-specs">
                            <i class="fas fa-car mb-2 d-block fs-5" style="color: var(--luxe-gold);"></i>
                            <span class="d-block small text-dynamic-muted">Parqueaderos</span>
                            <strong class="text-dynamic fs-5">{{ bien.garajes }}</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3 box-specs">
                            <i class="fas fa-vector-square mb-2 d-block fs-5" style="color: var(--luxe-gold);"></i>
                            <span class="d-block small text-dynamic-muted">Área (m²)</span>
                            <strong class="text-dynamic fs-5">{{ bien.surfaceM2 }}</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3 box-specs">
                            <i class="fas fa-layer-group mb-2 d-block fs-5" style="color: var(--luxe-gold);"></i>
                            <span class="d-block small text-dynamic-muted">Estrato</span>
                            <strong class="text-dynamic fs-5">{{ bien.estrato ?: '-' }}</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded-3 box-specs">
                            <i class="fas fa-key mb-2 d-block fs-5" style="color: var(--luxe-gold);"></i>
                            <span class="d-block small text-dynamic-muted">Estado</span>
                            <strong class="text-dynamic" style="font-size: 0.9rem;">{{ bien.etatDuBien }}</strong>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between p-3 rounded-3 mb-4" style="background: rgba(212, 175, 55, 0.05); border: 1px solid rgba(212, 175, 55, 0.2);">
                    <div>
                        <span class="d-block small text-dynamic-muted">Administración</span>
                        <strong class="text-dynamic">{{ bien.prixAdministration ? '$' ~ bien.prixAdministration|number_format(0, ',', '.') : 'Incluida' }}</strong>
                    </div>
                    <div class="text-end">
                        <span class="d-block small text-dynamic-muted">Año Construcción</span>
                        <strong class="text-dynamic">{{ bien.anoConstruccion ?: 'N/A' }}</strong>
                    </div>
                </div>

                {% if bien.description %}
                    <h4 class="h6 fw-bold mb-2 text-uppercase" style="color: var(--luxe-gold); letter-spacing: 1px;">Descripción</h4>
                    <p class="small text-dynamic-muted mb-4" style="white-space: pre-line; line-height: 1.7;">
                        {{ bien.description }}
                    </p>
                {% endif %}

                <div class="mt-4 d-grid gap-3">
                    {% if app.user %}
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary flex-grow-1 py-3" data-bs-toggle="modal" data-bs-target="#modalVisita">
                                <i class="far fa-calendar-check me-2"></i>Agendar Visita
                            </button>
                            <button type="button" class="btn btn-warning flex-grow-1 py-3" data-bs-toggle="modal" data-bs-target="#modalOferta">
                                <i class="fas fa-hand-holding-usd me-2"></i>Enviar Oferta
                            </button>
                        </div>
                    {% else %}
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_login') }}" class="btn btn-primary flex-grow-1 py-3" title="Inicia sesión para agendar">
                                <i class="far fa-calendar-check me-2"></i>Agendar Visita
                            </a>
                            <a href="{{ path('app_login') }}" class="btn btn-warning flex-grow-1 py-3" title="Inicia sesión para ofertar">
                                <i class="fas fa-hand-holding-usd me-2"></i>Enviar Oferta
                            </a>
                        </div>
                    {% endif %}
                    
                   {# === BOTÓN WHATSAPP LUXE === #}
                    <a href="{{ whatsappUrl }}" target="_blank" class="btn fw-bold py-3 w-100 d-flex justify-content-center align-items-center" style="background-color: #128C7E; color: #FFFFFF; border: 1px solid #0f7669; box-shadow: 0 4px 10px rgba(18, 140, 126, 0.15); transition: transform 0.2s ease; border-radius: 8px;">
                        <i class="fab fa-whatsapp fs-4 me-2"></i> Contactar Asesor por WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{# ========================================================= #}
{# === VISOR LUXE (LIGHTBOX PARA FOTOS EN PANTALLA COMPLETA) #}
{# ========================================================= #}
<div class="modal fade" id="lightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-centered">
        <div class="modal-content" style="background: rgba(10, 10, 12, 0.95); border: none;">
            <div class="modal-header border-0 position-absolute w-100 p-4" style="z-index: 1055;">
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1) grayscale(100%) brightness(200%); width: 1.5rem; height: 1.5rem;"></button>
            </div>
            <div class="modal-body d-flex align-items-center justify-content-center p-0" onclick="document.querySelector('#lightboxModal .btn-close').click()" style="cursor: zoom-out;">
                <img id="lightboxImage" src="" class="img-fluid shadow-lg" style="max-height: 90vh; max-width: 90vw; object-fit: contain; border: 1px solid rgba(212, 175, 55, 0.2);">
            </div>
        </div>
    </div>
</div>

<script>
    function abrirVisorLuxe(imagenSrc) {
        document.getElementById('lightboxImage').src = imagenSrc;
        var myModal = new bootstrap.Modal(document.getElementById('lightboxModal'));
        myModal.show();
    }
</script>

{# ========================================================= #}
{# === MODALES DE CONTACTO (SOLO VISIBLES SI LOGUEADO) === #}
{# ========================================================= #}
{% if app.user %}
    <style>
        .luxe-modal .modal-content { background: var(--luxe-card-bg, #1C1E22); border: 1px solid rgba(212, 175, 55, 0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.5); color: #E4E7EC; }
        .luxe-modal .modal-header { border-bottom: 1px solid rgba(255,255,255,0.05); }
        .luxe-modal .modal-footer { border-top: 1px solid rgba(255,255,255,0.05); }
        .luxe-modal .btn-close { filter: invert(1) grayscale(100%) brightness(200%); }
        
        html.light-mode .luxe-modal .modal-content { background: #FFFFFF; color: #212529; border: 1px solid rgba(0,0,0,0.1); }
        html.light-mode .luxe-modal .modal-header, html.light-mode .luxe-modal .modal-footer { border-color: rgba(0,0,0,0.1); }
        html.light-mode .luxe-modal .btn-close { filter: none; }
        
        .thumbnail-btn:focus, .thumbnail-btn:hover { border-color: var(--luxe-gold) !important; transform: scale(1.05); }
    </style>

    {# MODAL: SOLICITAR VISITA #}
    <div class="modal fade luxe-modal" id="modalVisita" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color: var(--luxe-gold);"><i class="far fa-calendar-check me-2"></i>Agendar Visita</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="{{ path('solicitar_visita', {'id': bien.id}) }}">
                    <div class="modal-body p-4">
                        <p class="small text-dynamic-muted mb-4">Selecciona la fecha en la que te gustaría visitar el inmueble. Un asesor te contactará para confirmar la hora.</p>
                        <div class="mb-3">
                            <label for="fecha_visita" class="form-label fw-bold small">Fecha deseada <span class="text-danger">*</span></label>
                            <input type="date" class="form-control custom-input" id="fecha_visita" name="fecha_visita" required min="{{ 'now'|date('Y-m-d') }}">
                        </div>
                        <div class="mb-3">
                            <label for="comentarios" class="form-label fw-bold small">Disponibilidad de horario</label>
                            <textarea class="form-control custom-input" id="comentarios" name="comentarios" rows="3" placeholder="Ej: Prefiero en las mañanas antes de las 10 AM..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary px-4">Enviar Solicitud</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# MODAL: ENVIAR OFERTA #}
    <div class="modal fade luxe-modal" id="modalOferta" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" style="color: var(--luxe-gold);"><i class="fas fa-hand-holding-usd me-2"></i>Enviar Oferta Formal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="{{ path('enviar_oferta', {'id': bien.id}) }}">
                    <div class="modal-body p-4">
                        <p class="small text-dynamic-muted mb-4">Tu propuesta económica será evaluada de forma confidencial por nuestro equipo de gerencia.</p>
                        <div class="mb-3">
                            <label for="precio_oferta" class="form-label fw-bold small">Valor de tu oferta (COP) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: var(--luxe-black); border: 1px solid rgba(212,175,55,0.3); color: var(--luxe-gold);">$</span>
                                <input type="number" class="form-control custom-input" id="precio_oferta" name="precio_oferta" required placeholder="Ej: 250000000" min="100000">
                            </div>
                            <div class="form-text mt-2" style="color: var(--luxe-gold);">Precio lista: $ {{ bien.prix|number_format(0, ',', '.') }} COP</div>
                        </div>
                        <div class="mb-3">
                            <label for="condiciones" class="form-label fw-bold small">Condiciones de compra</label>
                            <textarea class="form-control custom-input" id="condiciones" name="condiciones" rows="3" placeholder="Ej: Pago de contado, crédito preaprobado, permuta..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning px-4">Radicar Oferta</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}

{% endblock %}