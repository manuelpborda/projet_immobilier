{% extends 'base.html.twig' %}

{% block title %}Cambiar Contraseña - CONSORIA{% endblock %}

{% block body %}
<style>
    .profile-card { background: var(--luxe-card-bg, #1C1E22); border: 1px solid rgba(212, 175, 55, 0.2); }
    .form-luxe label { color: #E4E7EC; font-weight: 600; margin-bottom: 0.5rem; }
    .form-luxe input { background-color: var(--luxe-black, #111); border: 1px solid rgba(212, 175, 55, 0.3); color: #E4E7EC; border-radius: 8px; padding: 0.75rem 1rem; width: 100%; }
    .form-luxe input:focus { border-color: var(--luxe-gold, #D4AF37); }
    html.light-mode .profile-card { background: #FFFFFF; border: 1px solid rgba(0, 0, 0, 0.08); }
    html.light-mode .form-luxe label { color: #2C313C; }
    html.light-mode .form-luxe input { background-color: #F8F9FA; border: 1px solid #CED4DA; color: #212529; }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <a href="{{ path('app_profile') }}" class="text-decoration-none mb-3 d-inline-block" style="color: var(--luxe-gold);"><i class="fas fa-arrow-left me-1"></i> Volver a mi perfil</a>
            <h2 class="fw-bold mb-4" style="color: var(--luxe-gold);"><i class="fas fa-shield-alt me-2"></i> Cambiar Contraseña</h2>
            
            <div class="profile-card rounded-4 p-4 p-md-5">
                {{ form_start(form, {'attr': {'class': 'form-luxe'}}) }}
                    
                    <div class="mb-4">
                        {{ form_row(form.currentPassword) }}
                    </div>
                    
                    <div class="mb-4" style="border-top: 1px dashed rgba(212, 175, 55, 0.3); padding-top: 1.5rem;">
                        {{ form_row(form.newPassword.first) }}
                    </div>
                    <div class="mb-4">
                        {{ form_row(form.newPassword.second) }}
                    </div>

                    <button type="submit" class="btn w-100 fw-bold py-2 rounded-pill mt-3" style="background: var(--luxe-gold); color: #111;">
                        Actualizar Contraseña
                    </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}