{% extends 'base.html.twig' %}

{% block title %}Recuperar Contraseña - CONSORIA{% endblock %}

{% block body %}
<style>
    .auth-wrapper { min-height: 70vh; display: flex; align-items: center; padding: 3rem 0; }
    .card-luxe { background: var(--luxe-card-bg, #1C1E22); border: 1px solid rgba(212, 175, 55, 0.2); color: #E4E7EC; }
    .form-label-adaptable { color: #E4E7EC; font-weight: 600; margin-bottom: 0.5rem; }
    .form-control-luxe { background-color: var(--luxe-black, #111); border: 1px solid rgba(212, 175, 55, 0.3); color: #E4E7EC; border-radius: 8px; padding: 0.75rem 1rem; width: 100%; }
    .form-control-luxe:focus { border-color: var(--luxe-gold, #D4AF37); box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15); outline: none; }
    .texto-muteado { opacity: 0.85; }
    
    html.light-mode .card-luxe { background: #FFFFFF !important; border: 1px solid rgba(0, 0, 0, 0.08) !important; box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important; color: #212529 !important; }
    html.light-mode .form-label-adaptable { color: #2C313C !important; }
    html.light-mode .form-control-luxe { background-color: #F8F9FA !important; border: 1px solid #CED4DA !important; color: #212529 !important; }
    html.light-mode .form-control-luxe:focus { background-color: #FFFFFF !important; border-color: var(--luxe-gold, #D4AF37) !important; box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2) !important; }
    html.light-mode .texto-muteado { color: #495057 !important; opacity: 1; }
</style>

<div class="auth-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card-luxe rounded-4 p-4 p-md-5 shadow-lg">
                    <div class="text-center mb-4">
                        <i class="fas fa-unlock-alt fa-3x mb-3" style="color: var(--luxe-gold);"></i>
                        <h3 class="fw-bold">Recuperar Contraseña</h3>
                        <p class="texto-muteado small">Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.</p>
                    </div>

                    {{ form_start(requestForm) }}
                        <div class="mb-4">
                            {{ form_row(requestForm.email, {
                                'label': 'Correo electrónico',
                                'label_attr': {'class': 'form-label-adaptable'},
                                'attr': {'class': 'form-control-luxe', 'placeholder': 'tu@correo.com', 'autocomplete': 'email'}
                            }) }}
                        </div>

                        <button type="submit" class="btn w-100 fw-bold py-3 rounded-3 mb-3" style="background: linear-gradient(135deg, var(--luxe-gold), #AA8623); color: #111; font-size: 1.1rem; border: none; transition: transform 0.3s ease;">
                            <i class="fas fa-paper-plane me-2"></i> Enviar enlace
                        </button>
                    {{ form_end(requestForm) }}

                    <div class="text-center mt-4">
                        <a href="{{ path('app_login') }}" class="text-decoration-none small fw-bold" style="color: var(--luxe-gold);">
                            <i class="fas fa-arrow-left me-1"></i> Volver a Iniciar Sesión
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}