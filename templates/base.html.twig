    {# INFORMACIÓN DE CONTACTO (DISEÑO LUXE CENTRADO) #}
    <div class="container pb-5">
        <div class="row justify-content-center text-center g-4 mx-auto" style="max-width: 1000px;">
            
            {# OFICINA BOGOTÁ #}
            <div class="col-md-4 footer-col-luxe">
                <h6 class="fw-bold mb-3 text-uppercase" style="color: var(--luxe-gold, #D4AF37); letter-spacing: 1px;">
                    <i class="fas fa-map-marker-alt me-2"></i>Sede Colombia
                </h6>
                <p class="texto-footer-adaptable opacity-75 mb-1 small">Atención presencial (Zona Norte)</p>
                <p class="texto-footer-adaptable opacity-75 mb-1 small">Barrio Cedritos, Bogotá D.C.</p>
                <p class="texto-footer-adaptable opacity-50 mb-0 mt-2 small" style="font-style: italic;">* Atención exclusiva con cita previa</p>
            </div>
            
