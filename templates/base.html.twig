<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">

    {# === EVITO PARPADEO BLANCO (dark-mode aplicado antes de cargar estilos) === #}
    <script>
    if (localStorage.getItem('lightMode') === 'true') {
        document.documentElement.classList.add('light-mode');
    }
    </script>

    {# === SEO: Título Dinámico === #}
    <title>{% block title %}CONSORIA Inmobiliaria{% endblock %}</title>
    
    {# === SEO: Meta Descripción Dinámica === #}
    <meta name="description" content="{% block meta_description %}Encuentra las mejores casas y apartamentos en venta y arriendo con Consoria Inmobiliaria en Colombia y Francia. Descubre propiedades exclusivas adaptadas a tus necesidades.{% endblock %}">
     
    {# === SEO & RESPONSIVE === #}
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> 
    <meta name="robots" content="index, follow">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome (Iconos para UX) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">

    {# MEJORAS UX/UI PARA LA BARRA DE NAVEGACIÓN #}
    <style>
        .nav-wrapper {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
            padding: 0.5rem 1rem;
            background: var(--luxe-card-bg, #1C1E22); /* Fondo premium para la navbar */
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
        }
        .nav-enlaces a {
            font-size: 1.05rem; 
            text-decoration: none;
            transition: all 0.3s ease;
            color: #fff; /* Texto blanco por defecto */
        }
        .nav-enlaces a:hover {
            color: var(--luxe-gold, #D4AF37) !important;
        }
        .user-zone {
            margin-left: auto; 
            display: flex;
            align-items: center;
            gap: 1rem;
            border-left: 1px solid rgba(212, 175, 55, 0.3);
            padding-left: 1rem;
        }
        .text-gold {
            color: var(--luxe-gold, #D4AF37) !important; 
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100" style="background-color: var(--luxe-black, #111); color: #fff;">

    <nav class="nav-wrapper">
        {# LOGO DE LA EMPRESA #}
        <a href="{{ path('home') }}" class="me-3">
            <img src="{{ asset('assets/img/logo.webp') }}" alt="Logo CONSORIA Inmobiliaria" width="150" height="100" style="vertical-align:middle; object-fit: contain;">
        </a>

        <div class="nav-enlaces d-flex flex-wrap align-items-center gap-3 flex-grow-1">
            {% if app.user %}
                {% if 'ROLE_ADMIN' in app.user.roles %}
                    <a href="{{ path('admin_dashboard') }}">Panel Admin</a>
                    <a href="{{ path('admin_usuarios') }}">Usuarios</a>
                    <a href="{{ path('admin_documentos_index') }}" class="fw-bold text-warning">
                        <i class="fas fa-folder-open me-1"></i> Documentos
                    </a>
                    <a href="{{ path('admin_interacciones_index') }}" class="fw-bold text-warning">
                        <i class="fas fa-envelope-open-text me-1"></i> Solicitudes
                    </a>
                    <a href="{{ path('admin_estudios_index') }}" class="text-success fw-bold">
                        <i class="fas fa-file-invoice-dollar me-1"></i> Estudios
                    </a>
                    
                    {# === BOTÓN PARA QUE TU HERMANO CREE INMUEBLES === #}
                    {# === BOTÓN PARA QUE TU HERMANO CREE INMUEBLES === #}
                    <a href="{{ path('proprietaire_bien_nuevo') }}" class="btn btn-sm ms-2 fw-bold shadow-sm" style="background-color: var(--luxe-gold, #D4AF37); color: #111; border-radius: 20px; padding: 6px 15px;">
                        <i class="fas fa-plus-circle me-1"></i> Nuevo Inmueble
                    </a>
                    
                    {# ZONA DE PERFIL RESALTADA #}
                    <div class="user-zone">
                        <span class="text-gold fw-bold"><i class="fas fa-user-shield me-1"></i> Hola, {{ app.user.email|split('@')[0]|capitalize }}</span>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm rounded-pill px-3"><i class="fas fa-sign-out-alt me-1"></i> Salir</a>
                    </div>

                {% elseif 'ROLE_PROPRIETAIRE' in app.user.roles %}
                    <a href="{{ path('home') }}">Inicio</a>
                    <a href="{{ path('buy') }}">Comprar</a>
                    <a href="{{ path('sell') }}">Vender</a>
                    <a href="{{ path('rent') }}">Arriendo/Vacacional</a>
                    <a href="{{ path('estudio_credito') }}" class="text-success fw-bold"><i class="fas fa-file-invoice-dollar me-1"></i> Estudio de Crédito</a>
                    <a href="{{ path('proprietaire_dashboard') }}">Panel Propietario</a>
                    <a href="{{ path('proprietaire_bien_nuevo') }}">Publicar Bien</a>
                    <a href="{{ path('proprietaire_documentos') }}" class="text-gold fw-bold"><i class="fas fa-folder-open me-1"></i> Mis Documentos</a>
                    <a href="{{ path('contact') }}">Contacto</a>

                    {# ZONA DE PERFIL RESALTADA #}
                    <div class="user-zone">
                        <span class="text-gold fw-bold"><i class="fas fa-user-tie me-1"></i> Bienvenido, {{ app.user.email|split('@')[0]|capitalize }}</span>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm rounded-pill px-3"><i class="fas fa-sign-out-alt me-1"></i> Salir</a>
                    </div>

                {% elseif 'ROLE_CLIENT' in app.user.roles %}
                    <a href="{{ path('home') }}">Inicio</a>
                    <a href="{{ path('buy') }}">Comprar</a>
                    <a href="{{ path('sell') }}">Vender</a>
                    <a href="{{ path('rent') }}">Arriendo/Vacacional</a>
                    <a href="{{ path('estudio_credito') }}" class="text-success fw-bold"><i class="fas fa-file-invoice-dollar me-1"></i> Estudio de Crédito</a>
                    <a href="{{ path('client_dashboard') }}">Mi Panel</a>
                    <a href="{{ path('favoritos_index') }}">Mis Favoritos</a>
                    <a href="{{ path('contact') }}">Contacto</a>

                    {# ZONA DE PERFIL RESALTADA #}
                    <div class="user-zone">
                        <span class="text-gold fw-bold"><i class="fas fa-user me-1"></i> Hola, {{ app.user.email|split('@')[0]|capitalize }}</span>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm rounded-pill px-3"><i class="fas fa-sign-out-alt me-1"></i> Salir</a>
                    </div>
                {% endif %}
            {% else %}
                <a href="{{ path('home') }}">Inicio</a>
                <a href="{{ path('buy') }}">Comprar</a>
                <a href="{{ path('sell') }}">Vender</a>
                <a href="{{ path('rent') }}">Arriendo/Vacacional</a>
                <a href="{{ path('estudio_credito') }}" class="text-success fw-bold"><i class="fas fa-file-invoice-dollar me-1"></i> Estudio de Crédito</a>
                <a href="{{ path('about') }}">Nosotros</a>
                <a href="{{ path('contact') }}">Contacto</a>
                
                <div class="user-zone border-0">
                    <a href="{{ path('app_login') }}" class="btn btn-outline-light rounded-pill px-4" style="border-color: var(--luxe-gold, #D4AF37); color: var(--luxe-gold, #D4AF37);">Iniciar sesión</a>
                    <a href="{{ path('app_register') }}" class="btn rounded-pill px-4 fw-bold" style="background-color: var(--luxe-gold, #D4AF37); color: #111;">Registrarse</a>
                </div>
            {% endif %}
            
            <button id="darkModeToggle" class="btn btn-sm ms-2 rounded-circle" title="Modo Oscuro / Claro" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--luxe-gold, #D4AF37); color: var(--luxe-gold, #D4AF37);">
                <i class="fas fa-moon"></i>
            </button>
        </div>
    </nav>

    <div class="container mt-4 min-vh-100"><div class="container mt-4 mb-5 flex-grow-1">
    
        {# === GESTIÓN DE MENSAJES FLASH === #}
        {% for label, messages in app.flashes %}
            {% for msg in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show shadow-sm" role="alert" style="border-left: 4px solid var(--luxe-gold, #D4AF37);">
                    {{ msg }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </div>

<footer class="mt-auto" style="background: linear-gradient(180deg, #1C1E22 0%, #111 100%); border-top: 2px solid var(--luxe-gold, #D4AF37); padding-top: 2rem;">
    <div class="footer-gallery-container mb-4" style="position: relative; overflow: hidden; min-height: 100px;">
        <div class="footer-gallery">
            <img src="{{ asset('assets/footer-gallery/img7.webp') }}" alt="Galería 1" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img5.webp') }}" alt="Galería 2" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img3.webp') }}" alt="Galería 3" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img4.webp') }}" alt="Galería 4" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img6.webp') }}" alt="Galería 5" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img1.webp') }}" alt="Galería 6" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img8.webp') }}" alt="Galería 7" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img9.webp') }}" alt="Galería 8" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img10.webp') }}" alt="Galería 1 duplicado" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img7.webp') }}" alt="Galería 2 duplicado" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img4.webp') }}" alt="Galería 3 duplicado" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img9.webp') }}" alt="Galería 4 duplicado" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img6.webp') }}" alt="Galería 5 duplicado" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img8.webp') }}" alt="Galería 6 duplicado" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img3.webp') }}" alt="Galería 7 duplicado" loading="lazy">
        </div>
    </div>

    <div class="container pb-4">
        <div class="row text-center text-md-start g-4">
            {# OFICINA BOGOTÁ (CORREGIDA) #}
            <div class="col-md-4">
                <h6 class="text-gold fw-bold mb-3"><i class="fas fa-map-marker-alt me-2"></i>Oficina en Colombia</h6>
                <p class="text-white opacity-75 mb-1">Cra 7D # 151-42, Oficina 201</p>
                <p class="text-white opacity-75 mb-1">Bogotá, D.C.</p>
                {% if app.request.attributes.get('_route') == 'home' %}
                    <p id="clima-bogota" class="small text-muted mt-2"><i class="fas fa-cloud-sun me-1"></i> Clima: cargando...</p>
                {% endif %}
            </div>
            
            {# OFICINA PARÍS (PROYECTO DE EXPANSIÓN) #}
            <div class="col-md-4">
                <h6 class="text-gold fw-bold mb-3 d-flex align-items-center justify-content-center justify-content-md-start">
                    <i class="fas fa-globe-europe me-2"></i>Oficina en Francia 
                    <span class="badge bg-secondary ms-2" style="font-size: 0.65em; letter-spacing: 1px;">PROXIMAMENTE</span>
                </h6>
                <p class="text-white opacity-50 mb-1" style="font-style: italic;">Expansión internacional en desarrollo.</p>
                <p class="text-white opacity-50 mb-1" style="font-style: italic;">Próximamente en París, Europa.</p>
                {% if app.request.attributes.get('_route') == 'home' %}
                    <p id="clima-paris" class="small text-muted mt-2 opacity-50"><i class="fas fa-cloud-sun me-1"></i> Clima: cargando...</p>
                {% endif %}
            </div>
            
            {# CONTACTO #}
            <div class="col-md-4 text-md-end">
                <h6 class="text-gold fw-bold mb-3"><i class="fas fa-headset me-2"></i>Habla con un agente</h6>
                <a href="https://wa.me/573124504982" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success rounded-pill px-4 py-2">
                    <i class="fab fa-whatsapp me-2 fa-lg"></i> Contactar por WhatsApp
                </a>
            </div>
        </div>
    </div>

    <div class="footer-bottom text-center py-3" style="background: #000; border-top: 1px solid rgba(212, 175, 55, 0.1);">
        <p class="mb-0 small text-white opacity-50">
            &copy; {{ 'now'|date('Y') }} Consoria Inmobiliaria. Todos los derechos reservados. | 
            <a href="{{ path('mentions_legales') }}" class="text-white text-decoration-none hover-gold">Aviso Legal y Términos de Uso</a>
        </p>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('js/darkmode_toggle.js') }}"></script>
</body>
</html>