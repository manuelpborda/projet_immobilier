            <div class="col-md-4 footer-col-luxe">
                <h6 class="fw-bold mb-3 text-uppercase d-flex align-items-center justify-content-center" style="color: var(--luxe-gold, #D4AF37); letter-spacing: 1px;">
                    <i class="fas fa-globe-europe me-2"></i>Sede Francia
                </h6>
                <p class="texto-footer-adaptable opacity-50 mb-1 small" style="font-style: italic;">Expansión internacional en desarrollo.</p>
