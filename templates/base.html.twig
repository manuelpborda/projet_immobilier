            <img src="{{ asset('assets/footer-gallery/img7.webp') }}" alt="Galería 7" loading="lazy">
            <img src="{{ asset('assets/footer-gallery/img8.webp') }}" alt="Galería 8" loading="lazy">

            {# --- GRUPO 3 --- #}
