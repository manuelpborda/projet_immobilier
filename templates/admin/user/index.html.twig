{% extends 'base.html.twig' %}

{% block title %}Gestión de Usuarios - CONSORIA{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="h2 fw-bold text-primary mb-1"><i class="fas fa-users-cog me-2"></i>Gestión de Usuarios</h1>
            <p class="opacity-75 mb-0">Control total sobre clientes, propietarios y administradores de la plataforma.</p>
        </div>
        
        {# Botón para crear un nuevo usuario manualmente #}
        <a href="#" class="btn btn-primary shadow-sm fw-bold">
            <i class="fas fa-user-plus me-2"></i>Nuevo Usuario
        </a>
    </div>

    {# Buscador Inteligente #}
    <div class="card bg-body-tertiary border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" action="{{ path('admin_user_index') }}" class="d-flex gap-2">
                <div class="input-group">
                    <span class="input-group-text bg-body border-secondary-subtle"><i class="fas fa-search opacity-75"></i></span>
                    <input type="text" name="q" class="form-control bg-body border-secondary-subtle" placeholder="Buscar por nombre, correo o teléfono..." value="{{ search }}">
                </div>
                <button type="submit" class="btn btn-warning fw-bold text-dark px-4">Buscar</button>
                {% if search %}
                    <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">Limpiar</a>
                {% endif %}
            </form>
        </div>
    </div>

    {# Tabla Principal #}
    <div class="table-responsive shadow-sm rounded-3 overflow-hidden">
        <table class="admin-table m-0">
            <thead>
                <tr>
                    <th class="ps-4">Usuario</th>
                    <th>Contacto</th>
                    <th>Rol en Plataforma</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for usuario in usuarios %}
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-body-secondary rounded-circle d-flex align-items-center justify-content-center me-3 border border-secondary-subtle" style="width: 45px; height: 45px;">
                                    <i class="fas fa-user text-primary fs-5"></i>
                                </div>
                                <div>
                                    <div class="fw-bold fs-6">
                                        {{ usuario.firstName }} {{ usuario.lastName }}
                                        {% if not usuario.firstName and not usuario.lastName %}
                                            <span class="fst-italic opacity-50">Sin nombre registrado</span>
                                        {% endif %}
                                    </div>
                                    <small class="opacity-75 d-block">{{ usuario.email }}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% if usuario.phone %}
                                <a href="https://wa.me/{{ usuario.phone|replace({'+': '', ' ': ''}) }}" target="_blank" class="text-decoration-none text-body fw-semibold">
                                    <i class="fab fa-whatsapp text-success me-1"></i>{{ usuario.phone }}
                                </a>
                            {% else %}
                                <span class="small opacity-50">No registrado</span>
                            {% endif %}
                        </td>
                        <td>
                            {# Traducción visual de Roles con Badges Premium #}
                            {% if usuario.typeUser == 'admin' %}
                                <span class="badge bg-primary text-dark border px-3 py-2 rounded-pill"><i class="fas fa-shield-alt me-1"></i>Administrador</span>
                            {% elseif usuario.typeUser == 'proprietaire' %}
                                <span class="badge bg-info text-white border px-3 py-2 rounded-pill"><i class="fas fa-key me-1"></i>Propietario</span>
                            {% else %}
                                <span class="badge bg-success text-white border px-3 py-2 rounded-pill"><i class="fas fa-user-tag me-1"></i>Cliente VIP</span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                <a href="{{ path('admin_user_edit', {'id': usuario.id}) }}" class="btn btn-sm btn-outline-primary" title="Editar Usuario">
    <i class="fas fa-edit"></i>
</a>
                                
                                <form method="post" action="{{ path('admin_user_delete', {'id': usuario.id}) }}" onsubmit="return confirm('¿Estás seguro de que deseas eliminar permanentemente a este usuario? Esta acción no se puede deshacer.');" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ usuario.id) }}">
                                    <button class="btn btn-sm btn-outline-danger" title="Eliminar Usuario" {{ usuario == app.user ? 'disabled' : '' }}>
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <i class="fas fa-users-slash fa-3x mb-3 opacity-25"></i>
                            <p class="opacity-75 mb-0">No se encontraron usuarios con esos criterios de búsqueda.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}