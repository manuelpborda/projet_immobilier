{% extends 'base.html.twig' %}

{% block title %}Editar Usuario - CONSORIA{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="register-container mx-auto" style="max-width: 600px;">
        <h1><i class="fas fa-user-edit me-2"></i>Editar Perfil</h1>
        <p class="text-center opacity-75 mb-4">Actualizando datos de: <strong>{{ usuario.email }}</strong></p>

        {{ form_start(form, {'attr': {'class': 'contact-form'}}) }}
            <div class="row">
                <div class="col-md-6 form-group">
                    {{ form_label(form.firstName) }}
                    {{ form_widget(form.firstName, {'attr': {'class': 'form-control custom-input'}}) }}
                </div>
                <div class="col-md-6 form-group">
                    {{ form_label(form.lastName) }}
                    {{ form_widget(form.lastName, {'attr': {'class': 'form-control custom-input'}}) }}
                </div>
            </div>
            
            <div class="form-group mt-3">
                {{ form_label(form.phone) }}
                {{ form_widget(form.phone, {'attr': {'class': 'form-control custom-input', 'placeholder': '+57 300 000 0000'}}) }}
            </div>

            <div class="form-group mt-3">
                {{ form_label(form.typeUser) }}
                {{ form_widget(form.typeUser, {'attr': {'class': 'form-control custom-input'}}) }}
            </div>

            <div class="d-flex gap-3 mt-4">
                <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary w-50 fw-bold border-secondary-subtle">Cancelar</a>
                <button type="submit" class="btn btn-register w-50 m-0">Guardar Cambios</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}