{% extends 'base.html.twig' %}

{% block title %}Solicitudes de Estudio de Crédito - Admin{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold text-dark">
            <i class="fas fa-inbox text-primary me-2"></i>Solicitudes de Viabilidad Financiera
        </h1>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary shadow-sm">
            <i class="fas fa-arrow-left me-2"></i>Volver al Panel
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="ps-4">Fecha Solicitud</th>
                            <th scope="col">Cédula</th>
                            <th scope="col">Cliente</th>
                            <th scope="col">Celular</th>
                            <th scope="col">Monto Solicitado</th>
                            <th scope="col" class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for estudio in estudios %}
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-success text-white px-2 py-1">
                                        <i class="fas fa-calendar-alt me-1"></i>{{ estudio.fechaSolicitud|date('d/m/Y H:i') }}
                                    </span>
                                </td>
                                <td class="fw-bold">{{ estudio.cedula }}</td>
                                <td>{{ estudio.nombresApellidos }}</td>
                                <td>
                                    <a href="https://wa.me/57{{ estudio.celular }}" target="_blank" class="text-decoration-none text-success">
                                        <i class="fab fa-whatsapp me-1"></i>{{ estudio.celular }}
                                    </a>
                                </td>
                                <td>
                                    {% if estudio.valorSolicitado %}
                                        $ {{ estudio.valorSolicitado|number_format(0, ',', '.') }}
                                    {% else %}
                                        <span class="text-muted small">Por definir</span>
                                    {% endif %}
                                </td>
                                <td class="text-center pe-4">
                                    {# BOTÓN DE VER DETALLE #}
                                    <a href="{{ path('admin_estudios_show', {'id': estudio.id}) }}" class="btn btn-sm btn-primary shadow-sm" title="Ver detalles de la solicitud">
                                        <i class="fas fa-eye me-1"></i> Ver
                                    </a>
                                    
                                    {# BOTÓN DE ELIMINAR CON SEGURIDAD CSRF #}
                                    <form method="post" action="{{ path('admin_estudios_delete', {'id': estudio.id}) }}" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este estudio de crédito? Esta acción no se puede deshacer.');" style="display: inline-block;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ estudio.id) }}">
                                        <button class="btn btn-sm btn-outline-danger shadow-sm" title="Eliminar registro">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-folder-open fa-3x mb-3 text-secondary" style="opacity: 0.5;"></i><br>
                                    Aún no hay solicitudes de estudio de crédito registradas.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}