{# templates/proprietaire/nuevo.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Publicar Nuevo Inmueble - Propietario{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            
            {# Mensajes Flash del Sistema #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i> {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
            
            {# Detector de Errores de Validación del Servidor #}
            {% if not form.vars.valid %}
                <div class="alert alert-danger shadow-sm p-4">
                    <h5 class="alert-heading fw-bold text-danger mb-2">
                        <i class="fas fa-exclamation-triangle me-2"></i> Error al publicar el inmueble
                    </h5>
                    <p class="small mb-3">Se han detectado inconvenientes en los archivos o datos ingresados. Por favor verifique la siguiente lista:</p>
                    <ul class="mb-0 ps-3 small">
                        {% for error in form.vars.errors %}
                            <li>{{ error.message|replace({'El archivo subido es demasiado grande. Por favor, suba un archivo más pequeño.': 'Uno de los archivos excede el límite de 200 MB. Intente con un video más comprimido.'}) }}</li>
                        {% endfor %}
                        
                        {% for child in form.children %}
                            {% for error in child.vars.errors %}
                                <li>
                                    <span class="fw-bold">{{ child.vars.label }}:</span> 
                                    {{ error.message|replace({'El archivo subido es demasiado grande. Por favor, suba un archivo más pequeño.': 'Este archivo es demasiado pesado. El límite es de 200 MB.'}) }}
                                </li>
                            {% endfor %}
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <div class="card shadow-lg border-0 rounded-3 mt-3">
                <div class="card-header bg-dark text-white text-center py-4 rounded-top">
                    <h2 class="mb-0"><i class="fas fa-home me-2"></i> Publicar Inmueble</h2>
                    <p class="mb-0 text-white-50 mt-1">Completa la información para que tu propiedad destaque.</p>
                </div>
                
                <div class="card-body p-4 p-md-5 bg-light">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'enctype': 'multipart/form-data'}}) }}

                    {# --- SECCIÓN 1: DATOS GENERALES --- #}
                    <div class="bg-white p-4 rounded shadow-sm mb-4">
                        <h4 class="text-primary mb-3 border-bottom pb-2">1. Información Básica</h4>
                        <div class="row g-3">
                            <div class="col-md-8">{{ form_row(form.titulo) }}</div>
                            <div class="col-md-4">{{ form_row(form.matricula) }}</div>
                            <div class="col-md-6">{{ form_row(form.tipoTransaccion) }}</div>
                            <div class="col-md-6">{{ form_row(form.typeDeBien) }}</div>
                            <div class="col-md-6">{{ form_row(form.prix) }}</div>
                            <div class="col-md-6">{{ form_row(form.prixAdministration) }}</div>
                            <div class="col-md-4">{{ form_row(form.etatDuBien) }}</div>
                            <div class="col-md-4">{{ form_row(form.anoConstruccion) }}</div>
                            <div class="col-md-4">{{ form_row(form.estrato) }}</div>
                        </div>
                    </div>

                    {# --- SECCIÓN 2: CARACTERÍSTICAS --- #}
                    <div class="bg-white p-4 rounded shadow-sm mb-4">
                        <h4 class="text-primary mb-3 border-bottom pb-2">2. Características del Inmueble</h4>
                        <div class="row g-3">
                            <div class="col-md-3">{{ form_row(form.habitaciones) }}</div>
                            <div class="col-md-3">{{ form_row(form.banos) }}</div>
                            <div class="col-md-3">{{ form_row(form.garajes) }}</div>
                            <div class="col-md-3">{{ form_row(form.numeroPiso) }}</div>
                            <div class="col-md-6">{{ form_row(form.surfaceM2) }}</div>
                            <div class="col-md-6">{{ form_row(form.areaConstruida) }}</div>
                            <div class="col-12">{{ form_row(form.description) }}</div>
                        </div>
                    </div>

                    {# --- SECCIÓN 3: UBICACIÓN --- #}
                    <div class="bg-white p-4 rounded shadow-sm mb-4">
                        <h4 class="text-primary mb-3 border-bottom pb-2">3. Ubicación</h4>
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_row(form.departamento) }}
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label required fw-bold">Ciudad</label>
                                <select id="select-visual-ciudad" class="form-select" disabled>
                                    <option value="">Primero seleccione un departamento</option>
                                </select>
                                {{ form_widget(form.ville) }}
                                {{ form_errors(form.ville) }}
                            </div>

                            <div class="col-md-6">{{ form_row(form.barrio) }}</div>
                            <div class="col-md-6">{{ form_row(form.adresse) }}</div>
                        </div>
                    </div>

                    {# --- SECCIÓN 4: MULTIMEDIA --- #}
                    <div class="bg-white p-4 rounded shadow-sm mb-4">
                        <h4 class="text-primary mb-3 border-bottom pb-2">4. Galería de Fotos</h4>
                        
                        <div class="alert alert-warning d-flex align-items-center small py-2 mb-4" role="alert">
                            <i class="fas fa-info-circle me-2 fs-5"></i>
                            <div>
                                <strong>Límite de carga ampliado:</strong> Máximo <strong>200 MB</strong> por archivo. Formatos: JPG, PNG, WEBP y Video MP4.
                            </div>
                        </div>

                        {# AQUÍ ESTÁ EL CAMBIO DE LA FOTO DE PORTADA #}
                        <div class="row g-4 mt-2">
                            {% for i in 1..6 %}
                                <div class="col-md-4 col-sm-6 text-file-box">
                                    <div class="border p-3 rounded position-relative {{ i == 1 ? 'border-primary bg-primary bg-opacity-10 shadow' : 'bg-light' }}">
                                        
                                        {% if i == 1 %}
                                            <span class="badge bg-primary position-absolute top-0 start-50 translate-middle px-3 py-2 shadow-sm" style="font-size: 0.85rem;">
                                                <i class="fas fa-star text-warning me-1"></i> FOTO DE PORTADA
                                            </span>
                                        {% endif %}
                                        
                                        {{ form_row(attribute(form, 'foto' ~ i)) }}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        <div id="extra-photos" style="display: none;">
                            <div class="row g-3 mt-1">
                                {% for i in 7..20 %}
                                    <div class="col-md-4 col-sm-6 text-file-box">
                                        <div class="border p-2 rounded bg-light">
                                            {{ form_row(attribute(form, 'foto' ~ i)) }}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button type="button" id="btn-toggle-photos" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                                <i class="fas fa-plus-circle me-2"></i> Añadir más fotos (hasta 20)
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a href="{{ path('proprietaire_dashboard') }}" class="btn btn-secondary btn-lg px-4">Cancelar</a>
                        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold">
                            <i class="fas fa-cloud-upload-alt me-2"></i> Publicar Inmueble
                        </button>
                    </div>

                    {{ form_rest(form) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const btnToggle = document.getElementById('btn-toggle-photos');
        const extraPhotos = document.getElementById('extra-photos');

        if(btnToggle && extraPhotos) {
            btnToggle.addEventListener('click', function() {
                if (extraPhotos.style.display === 'none') {
                    extraPhotos.style.display = 'block';
                    btnToggle.innerHTML = '<i class="fas fa-minus-circle me-2"></i> Ocultar fotos adicionales';
                    btnToggle.classList.replace('btn-outline-primary', 'btn-outline-secondary');
                } else {
                    extraPhotos.style.display = 'none';
                    btnToggle.innerHTML = '<i class="fas fa-plus-circle me-2"></i> Añadir más fotos (hasta 20)';
                    btnToggle.classList.replace('btn-outline-secondary', 'btn-outline-primary');
                }
            });
        }

        // --- VALIDACIÓN DE PESO EN TIEMPO REAL (AHORA A 200 MB) ---
        const inputsArchivo = document.querySelectorAll('input[type="file"]');
        const MAX_BYTES = 200 * 1024 * 1024; // 200 Megabytes

        inputsArchivo.forEach(function(input) {
            input.addEventListener('change', function() {
                if (this.files && this.files[0]) {
                    const archivo = this.files[0];
                    const pesoEnMB = (archivo.size / (1024 * 1024)).toFixed(2);
                    
                    const errorPrevio = this.parentNode.querySelector('.js-error-peso');
                    if (errorPrevio) errorPrevio.remove();

                    if (archivo.size > MAX_BYTES) {
                        const avisoError = document.createElement('div');
                        avisoError.className = 'text-danger small fw-bold mt-1 js-error-peso animate__animated animate__fadeIn';
                        avisoError.innerHTML = `<i class="fas fa-times-circle me-1"></i> Archivo demasiado pesado (${pesoEnMB} MB). El límite es 200 MB.`;
                        
                        this.parentNode.appendChild(avisoError);
                        this.value = ''; 
                    }
                }
            });
        });

        // Diccionario de Ubicación
        const diccionarioUbicacion = {
            'Antioquia': ['Medellín', 'Bello', 'Itagüí', 'Envigado', 'Rionegro', 'Apartadó', 'Sabaneta', 'Caldas'],
            'Atlántico': ['Barranquilla', 'Soledad', 'Malambo', 'Sabanalarga', 'Puerto Colombia'],
            'Bogotá D.C.': ['Bogotá D.C.'],
            'Bolívar': ['Cartagena', 'Magangué', 'Turbaco', 'Arjona'],
            'Boyacá': ['Tunja', 'Duitama', 'Sogamoso', 'Chiquinquirá'],
            'Caldas': ['Manizales', 'La Dorada', 'Villamaría', 'Chinchiná'],
            'Cauca': ['Popayán', 'Quilichao', 'El Tambo'],
            'Cesar': ['Valledupar', 'Aguachica', 'Agustín Codazzi'],
            'Córdoba': ['Montería', 'Lorica', 'Sahagún', 'Cereté'],
            'Cundinamarca': ['Soacha', 'Chía', 'Zipaquirá', 'Facatativá', 'Fusagasugá', 'Girardot', 'Cajicá', 'Funza'],
            'Huila': ['Neiva', 'Pitalito', 'Garzón'],
            'La Guajira': ['Riohacha', 'Maicao', 'Uribia'],
            'Magdalena': ['Santa Marta', 'Ciénaga', 'Fundación'],
            'Meta': ['Villavicencio', 'Acacías', 'Granada'],
            'Nariño': ['Pasto', 'Tumaco', 'Ipiales'],
            'Norte de Santander': ['Cúcuta', 'Ocaña', 'Villa del Rosario', 'Pamplona'],
            'Quindío': ['Armenia', 'Calarcá', 'Montenegro'],
            'Risaralda': ['Pereira', 'Dosquebradas', 'Santa Rosa de Cabal'],
            'Santander': ['Bucaramanga', 'Floridablanca', 'Barrancabermeja', 'Piedecuesta', 'Girón'],
            'Sucre': ['Sincelejo', 'Corozal'],
            'Tolima': ['Ibagué', 'Espinal', 'Melgar'],
            'Valle del Cauca': ['Cali', 'Buenaventura', 'Palmira', 'Tuluá', 'Yumbo', 'Cartago', 'Jamundí', 'Buga']
        };

        const deptoSelect = document.getElementById('bien_departamento');
        const ciudadVisual = document.getElementById('select-visual-ciudad');
        const hiddenVilleInput = document.getElementById('bien_ville');

        if(deptoSelect && ciudadVisual && hiddenVilleInput) {
            deptoSelect.addEventListener('change', function() {
                const deptoEscogido = this.value;
                ciudadVisual.innerHTML = '<option value="">Seleccione una ciudad...</option>';
                hiddenVilleInput.value = ''; 
                
                if (deptoEscogido && diccionarioUbicacion[deptoEscogido]) {
                    ciudadVisual.disabled = false;
                    diccionarioUbicacion[deptoEscogido].forEach(function(ciudad) {
                        const option = document.createElement('option');
                        option.value = ciudad;
                        option.textContent = ciudad;
                        ciudadVisual.appendChild(option);
                    });
                } else {
                    ciudadVisual.disabled = true;
                    ciudadVisual.innerHTML = '<option value="">Primero seleccione un departamento</option>';
                }
            });

            ciudadVisual.addEventListener('change', function() {
                hiddenVilleInput.value = this.value;
            });
        }
    });
</script>
{% endblock %}