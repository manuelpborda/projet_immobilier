{# templates/proprietaire/documentos.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mis Documentos Privados - CONSORIA Inmobiliaria{% endblock %}

{% block body %}
<div class="container mt-5 mb-5">
    <div class="row">
        <!-- Columna Formulario -->
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h5 class="mb-0"><i class="fas fa-file-upload me-2"></i> Compartir Documento</h5>
                </div>
                <div class="card-body bg-light">
                    <p class="small text-muted">Sube contratos, escrituras o facturas firmadas aquí. Se guardarán en un repositorio encriptado accesible solo por ti y la administración de la agencia.</p>
                    
                    {{ form_start(form) }}
                        <div class="mb-3">{{ form_row(form.tipoDocumento) }}</div>
                        <div class="mb-3">{{ form_row(form.archivo) }}</div>
                        <button type="submit" class="btn btn-success w-100 fw-bold mt-2">
                            <i class="fas fa-lock me-1"></i> Subir de Forma Segura
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
            <div class="mt-3">
                <a href="{{ path('proprietaire_dashboard') }}" class="btn btn-link text-secondary p-0">
                    <i class="fas fa-arrow-left me-2"></i> Volver al panel principal
                </a>
            </div>
        </div>

        <!-- Columna Historial -->
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-folder-open me-2"></i> Historial de Archivos Compartidos</h5>
                </div>
                <div class="card-body p-0">
                    {% if documentos is empty %}
                        <div class="p-4 text-center text-muted">
                            <i class="fas fa-info-circle fs-3 mb-2 d-block"></i> No has compartido ningún documento legal todavía.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Documento</th>
                                        <th>Tipo</th>
                                        <th>Fecha Subida</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for doc in documentos %}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="fas {{ doc.nombreOriginal|split('.')|last|lower == 'pdf' ? 'fa-file-pdf text-danger' : 'fa-file-image text-warning' }} fs-4"></i>
                                                    <span class="fw-bold small text-truncate d-inline-block" style="max-width: 250px;">{{ doc.nombreOriginal }}</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge {{ doc.tipoDocumento == 'Contrato' ? 'bg-info' : (doc.tipoDocumento == 'Escritura' ? 'bg-purple text-white' : 'bg-secondary') }}">
                                                    {{ doc.tipoDocumento|upper }}
                                                </span>
                                            </td>
                                            <td class="small text-muted">{{ doc.fechaSubida|date('d/m/Y h:i A') }}</td>
                                            <td class="text-center">
                                                <div class="d-flex justify-content-center gap-2">
                                                    <a href="{{ path('documento_descargar', {'id': doc.id}) }}" class="btn btn-sm btn-outline-primary" title="Ver / Descargar">
                                                        <i class="fas fa-download"></i>
                                                    </a>
                                                    <form method="post" action="{{ path('proprietaire_documento_eliminar', {'id': doc.id}) }}" onsubmit="return confirm('¿Seguro que deseas eliminar este documento del servidor? Esta acción no se puede deshacer.');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_doc' ~ doc.id) }}">
                                                        <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash-alt"></i></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}