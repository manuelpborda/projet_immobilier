###> symfony/framework-bundle ###
# Entorno de la aplicación (dev = desarrollo, prod = producción)
APP_ENV=dev
APP_SECRET=Blacksabath1986
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Configuración de Doctrine para MySQL (Conexión al puerto 3307 de tu MAMP/Docker)
# Formato: mysql://usuario:contraseña@servidor:puerto/nombre_bd?serverVersion=versión
DATABASE_URL="mysql://root:root@host.docker.internal:3307/agence_immobiliere?serverVersion=8.0"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Cola de mensajería asíncrona (utiliza la tabla por defecto de Doctrine en MySQL)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Configuración del servidor de correo saliente (SMTP de Gmail con contraseña de aplicación)
MAILER_DSN=smtp://consoriainmobiliaria@gmail.com:upsluggmviepbge@smtp.gmail.com:587
###< symfony/mailer ###

# =========================================================================
# CONFIGURACIÓN PERSONALIZADA DE LA APLICACIÓN (AGENCIA INMOBILIARIA)
# =========================================================================

# Sistema de almacenamiento para los mensajes del formulario de contacto
# Opciones disponibles en el proyecto: 'mysql' (o 'database') / 'mongo'
CONTACT_STORAGE=mysql

# =========================================================================
# SECCIÓN PASIVA DE MONGODB (NO UTILIZADA EN LA LÓGICA DE NEGOCIO)
# =========================================================================
# NOTA: Aunque no usemoos Mongo, mantenemos estas variables con datos estructurados.
# Esto evita que los archivos internos de configuración de DoctrineMongoDBODM 
# dejen la URL vacía y provoquen el fallo 'InvalidArgumentException' al compilar.
MONGODB_USER=root
MONGODB_USERNAME=root
MONGODB_PASSWORD=root
MONGODB_SERVER=127.0.0.1
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DB=inmobiliaria
MONGODB_DATABASE=inmobiliaria
MONGODB_AUTH_SOURCE=admin
MONGODB_URL="mongodb://root:root@127.0.0.1:27017/inmobiliaria?authSource=admin"